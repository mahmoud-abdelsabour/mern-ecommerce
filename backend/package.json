{
    "name": "backend",
    "version": "1.0.0",
    "description": "backend server for ecommerce app",
    "main": "index.js",
    "scripts": {
        "start": "cross-env NODE_ENV=production node index.js",
        "dev": "cross-env NODE_ENV=development nodemon index.js",
        "test": "cross-env NODE_ENV=test jest --runInBand",
        "start:test": "NODE_ENV=test node index.js",
        "lint": "eslint . --config ./utils/config/eslint.cjs",
    "lint:fix": "eslint . --config ./utils/config/eslint.cjs --fix",
    "format": "prettier . --config ./utils/config/prettier.cjs --ignore-path ./utils/config/.prettierignore --write",
    "format:check": "prettier . --config ./utils/config/prettier.cjs --ignore-path ./utils/config/.prettierignore --check",
    "seed": "cross-env NODE_ENV=development node utils/seed.js"
  },
    "author": "Mahmoud Ahmed",
    "license": "ISC",
    "dependencies": {
        "@jridgewell/resolve-uri": "^3.1.2",
        "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "@faker-js/faker": "^9.7.0",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.3.0",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.2.2",
        "slugify": "^1.6.6",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.2.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.3.3",
        "supertest": "^7.0.0"
    }
}
